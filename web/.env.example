NOTION_API_KEY=ntn_...
# 루트 .env 의 NOTION_PAGE_ID 와 동일 (32자 hex UUID)
NOTION_PAGE_ID=abcdef0123456789abcdef0123456789

# 로컬 dev 전용 — Vercel은 public/dashboard.snapshot.json 만 읽음 (Notion 키 불필요)
# CLAUDE_CODE_OAUTH_TOKEN=...

# GHA export:dashboard 시 Notion에서 읽을 주 수 (기본 4)
# NOTION_MAX_WEEKS=4

# 로컬 dev 캐시
# NOTION_CACHE_SECONDS=1800
# NOTION_STALE_SECONDS=86400
