NOTION_API_KEY=ntn_...
# 루트 .env 의 NOTION_PAGE_ID 와 동일 (32자 hex UUID)
NOTION_PAGE_ID=abcdef0123456789abcdef0123456789

# Vercel: Notion 읽기 전용 (트렌드·수집 LLM은 GitHub Actions 전용)
# NOTION_MAX_WEEKS=2          # Vercel 기본 2주 (Hobby 10s 한도). 로컬 기본 4주
# NOTION_CACHE_SECONDS=1800   # Notion 캐시 TTL (30분) · ISR revalidate 와 맞춤
# NOTION_STALE_SECONDS=86400  # dev stale-while-revalidate 최대 (24시간)
# NOTION_MIN_GAP_MS=500       # API 호출 간격 (ms)
