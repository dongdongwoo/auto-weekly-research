NOTION_API_KEY=ntn_...
# 루트 .env 의 NOTION_PAGE_ID 와 동일 (32자 hex UUID)
NOTION_PAGE_ID=abcdef0123456789abcdef0123456789

# 로컬 dev — 기본은 Vercel과 동일하게 public/dashboard.snapshot.json (Notion API 안 씀)
# Notion에서 직접 읽어 UI 확인할 때만:
# NOTION_LIVE=1
# NOTION_API_KEY=...
# CLAUDE_CODE_OAUTH_TOKEN=...

# GHA export:dashboard 시 Notion에서 읽을 고유 주 수 (기본 8, weekId 중복 페이지는 1개로 합침)
# NOTION_MAX_WEEKS=8

# 로컬 dev 캐시
# NOTION_CACHE_SECONDS=1800
# NOTION_STALE_SECONDS=86400
