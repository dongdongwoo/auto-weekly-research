NOTION_API_KEY=ntn_...
# 루트 .env 의 NOTION_PAGE_ID 와 동일 (32자 hex UUID)
NOTION_PAGE_ID=abcdef0123456789abcdef0123456789

# 데일리 급등 LLM — web/.env.local 없으면 루트 ../.env 자동 사용
# CLAUDE_CODE_OAUTH_TOKEN=...
# CLAUDE_MODEL=claude-fable-5

# 선택 — Notion API 부하 줄이기 (rate limit 방지)
# NOTION_MAX_WEEKS=4          # 기본 4주. dev 에서는 2~3 권장
# NOTION_CACHE_SECONDS=1800   # 디스크+메모리 캐시 TTL (30분)
# NOTION_MIN_GAP_MS=400       # API 호출 간격 (ms)
