# Claude 인증 (둘 중 하나 — 구독 사용 시 OAuth만)
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# ANTHROPIC_API_KEY=sk-ant-...   # API 과금. OAuth와 동시 설정 시 API 키가 우선됨

# Notion
NOTION_API_KEY=ntn_...
NOTION_PAGE_ID=32자리hex페이지ID

# NOTION_PAGE_ID = 주간 페이지들이 생성될 부모(허브) 페이지
# Integration을 이 페이지에 연결해 두세요.

# OAuth 토큰 발급: claude setup-token  (Pro/Max/Team 구독 필요)

# 모델 (OAuth와 별개 — 구독 쿼터에서 차감)
CLAUDE_MODEL=claude-opus-4-6
# 다른 예: claude-sonnet-4-6, claude-fable-5

# 선택 — Agent SDK 최대 턴 (morning/weekly 검색 시 error_max_turns 나오면 올리기)
# MAX_TURNS=25          # 컨텍스트만 (주간 초안)
# MAX_TURNS_SEARCH=55   # 웹 검색 수집·검증 (기본 55, 부족하면 70~80)
